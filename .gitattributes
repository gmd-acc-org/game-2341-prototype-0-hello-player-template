# GAME-2341 Unity starter: identical line endings on Windows and macOS.
# Text files are stored and checked out with LF everywhere, so Unity's YAML, .meta
# GUIDs and scripts never show phantom changes on Windows. Binary assets are never
# touched by line-ending conversion.

* text=auto eol=lf

# Unity YAML (Force Text serialization)
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.meta      text eol=lf
*.mat       text eol=lf
*.anim      text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.inputactions text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.cs        text eol=lf diff=csharp
*.shader    text eol=lf
*.hlsl      text eol=lf
*.json      text eol=lf
*.md        text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.exr binary
*.hdr binary
*.fbx binary
*.obj binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aif binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.a binary
*.bytes binary
*.unitypackage binary
